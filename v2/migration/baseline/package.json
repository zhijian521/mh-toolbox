{
  "name": "mh-tool",
  "productName": "梦幻养老助手",
  "version": "0.1.0",
  "description": "梦幻西游养老记录日志：收益记录、目标记录、装备更新管理",
  "main": "src/main/main.js",
  "author": "zhijian",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/electron.cjs . --dev",
    "start": "node scripts/electron.cjs .",
    "smoke": "node scripts/electron.cjs . --smoke",
    "shots": "node scripts/electron.cjs . --screenshot",
    "demo": "node scripts/electron.cjs . --demo",
    "test": "node scripts/test.cjs domain",
    "test:electron": "node scripts/test.cjs electron",
    "dist": "electron-builder --win",
    "check": "node scripts/test.cjs syntax"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.zhijian.mhtool",
    "productName": "梦幻养老助手",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "!node_modules/onnxruntime-node/bin/napi-*/{darwin,linux,android}/**/*",
      "!node_modules/onnxruntime-node/bin/napi-*/win32/{arm64,ia32}/**/*"
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "梦幻养老助手",
      "artifactName": "梦幻养老助手-安装版-${version}.exe"
    },
    "portable": {
      "artifactName": "梦幻养老助手-便携版-${version}.exe"
    }
  },
  "overrides": {
    "@gutenye/ocr-node": { "sharp": "$sharp" },
    "onnxruntime-node": { "adm-zip": "0.6.1" }
  },
  "dependencies": {
    "@gutenye/ocr-node": "1.4.9",
    "onnxruntime-node": "1.22.0-rev",
    "sharp": "0.35.5"
  }
}
