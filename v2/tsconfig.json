{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "noEmit": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": ["vite/client", "node"]
    },
    "include": [
        "src/renderer/**/*.ts",
        "src/renderer/**/*.vue",
        "src/renderer/**/*.js",
        "vite.config.ts"
    ]
}
