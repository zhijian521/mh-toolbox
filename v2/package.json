{
    "name": "mh-tool-v2",
    "productName": "梦幻养老助手 V2",
    "version": "0.2.0-alpha.1",
    "private": true,
    "type": "module",
    "main": "src/main/main.cjs",
    "description": "梦幻养老助手 Vue 重构版，使用独立数据目录",
    "author": "zhijian",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:web": "vite",
        "build": "vite build",
        "start": "node scripts/electron.mjs .",
        "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "vue-tsc --noEmit",
        "test": "node --test tests/domain/*.test.cjs tests/*.test.mjs",
        "test:electron": "node scripts/electron.mjs tests/app.electron.cjs",
        "check": "npm run typecheck && npm test",
        "dist:dir": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
        "dist": "npm run build && electron-builder --win --config electron-builder.config.cjs",
        "migration:status": "node scripts/migration-status.mjs"
    },
    "dependencies": {
        "pinia": "^3.0.4",
        "vue": "^3.5.44",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "electron": "^38.0.0",
        "electron-builder": "^26.0.0",
        "prettier": "3.6.2",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vue-tsc": "^3.1.8"
    }
}
