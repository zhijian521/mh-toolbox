{
    "name": "mh-tool-v2",
    "productName": "梦幻养老助手 V2",
    "version": "0.2.0-alpha.1",
    "private": true,
    "type": "module",
    "main": "src/main/main.cjs",
    "description": "梦幻养老助手 Vue 重构版，使用独立数据目录",
    "author": "zhijian",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "semi": true,
        "trailingComma": "all",
        "printWidth": 100,
        "bracketSpacing": true,
        "bracketSameLine": false,
        "arrowParens": "always",
        "endOfLine": "lf",
        "htmlWhitespaceSensitivity": "ignore",
        "vueIndentScriptAndStyle": false
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:web": "vite",
        "build": "vite build",
        "start": "node scripts/electron.mjs .",
        "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:commits": "git log -20 --no-merges --format=%s | node scripts/check-commits.mjs",
        "typecheck": "vue-tsc --noEmit",
        "test": "node --test \"tests/domain/*.test.cjs\" \"tests/domain/*.test.mjs\" \"tests/*.test.mjs\"",
        "test:electron": "node scripts/test-electron.mjs",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
        "verify": "npm run check && npm run build && npm run test:electron",
        "dist:dir": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
        "dist": "npm run build && electron-builder --win --config electron-builder.config.cjs",
        "migration:status": "node scripts/migration-status.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "electron": "^38.0.0",
        "electron-builder": "^26.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^15.15.0",
        "pinia": "^3.0.4",
        "prettier": "3.6.2",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.3.1",
        "vue": "^3.5.44",
        "vue-eslint-parser": "^10.4.1",
        "vue-router": "^4.6.4",
        "vue-tsc": "^3.1.8"
    }
}
